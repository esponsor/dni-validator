      "import": "./dist/brazil/index.js"
    },
    "./canada": {
      "types": "./dist/canada/index.d.ts",
      "import": "./dist/canada/index.js"
    },
    "./chile": {
      "types": "./dist/chile/index.d.ts",
      "import": "./dist/chile/index.js"
    },
    "./colombia": {
      "types": "./dist/colombia/index.d.ts",
      "import": "./dist/colombia/index.js"
    },
    "./ecuador": {
      "types": "./dist/ecuador/index.d.ts",
      "import": "./dist/ecuador/index.js"
